# @file .gitattributes
# @description 统一行尾与二进制识别。本项目是「Windows 开发 + Linux 部署」的混合环境，
#   若不显式声明，`core.autocrlf=true`（Windows 默认安装常勾选）会让 checkout 出的文件变成 CRLF，
#   而 shell 脚本带 CRLF 上传到 Linux 会直接报 `bad interpreter: /usr/bin/env bash^M`——
#   这是最难排查的一类部署故障（文件内容看起来完全正常，编辑器也不显示 ^M）。
#   因此明确：文本文件一律 LF（仓库内 + 检出后都是 LF），仅 Windows 专用脚本用 CRLF。
#
#   @author donttemo
#   @created 2026-10-14

# 默认：自动识别文本文件，统一 LF
* text=auto eol=lf

# 可执行脚本 / 源码：必须是 LF（eol=lf 已覆盖，此处显式声明以防将来规则被改动）
*.sh    text eol=lf
*.bash  text eol=lf
*.mjs   text eol=lf
*.js    text eol=lf
*.cjs   text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.vue   text eol=lf
*.prisma text eol=lf

# 配置与文档
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.conf  text eol=lf
*.env   text eol=lf
*.example text eol=lf

# systemd 单元与无扩展名脚本：按文本处理
fw-api.service        text eol=lf
fw-worker@.service    text eol=lf
Dockerfile            text eol=lf

# Windows 专用脚本：保留 CRLF（cmd.exe 对 LF 的批处理容错很差）
*.bat   text eol=crlf
*.cmd   text eol=crlf

# 二进制：禁止任何行尾转换与文本 diff，避免损坏
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.webp   binary
*.woff   binary
*.woff2  binary
*.ttf    binary
*.db     binary
*.sqlite binary
*.sqlite3 binary
*.node   binary
*.so     binary
*.dll    binary
*.exe    binary

# pnpm lockfile 在 diff 中隐藏（体积大、机器生成）
pnpm-lock.yaml -diff

# 语言统计：把构建产物与文档从 GitHub 语言占比里排除
dist/**      linguist-generated=true
*.min.js     linguist-generated=true
docs/**      linguist-documentation=true
