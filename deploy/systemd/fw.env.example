# @file 裸机部署环境变量样例（云服务器，systemd EnvironmentFile）
# @description 复制为 /opt/fw/shared/.env 后按实际环境修改，权限设为 600、属主 fw。
#   格式约束（systemd EnvironmentFile 与 .env 不同）：KEY=VALUE 行式，**不支持 export 前缀、不支持变量插值、
#   不支持 ${} 引用**，值内出现 $ 会被 systemd 当作变量展开——含特殊字符的密钥请用单引号包裹整值。
#   本文件任一必填项缺失时应用启动即失败并列明缺失项（@fw/config 校验，属预期行为）。
# @author donttemo
# @created 2026-10-14
# @module deploy

# ============ 运行环境 ============
APP_ENV=prod
APP_PORT=3000
LOG_LEVEL=info
# 日志输出格式由 @fw/logger 固定为结构化 JSON（含 time/level/traceId/spanId/module/msg/ctx），
# 不提供格式切换键（配置诚实原则：无效键不留，原 LOG_FORMAT 已于 2026-10-15 从文档与编排移除）。
# 优雅停机等待在途请求超时（秒）；必须小于 fw-api.service 的 TimeoutStopSec=30
SHUTDOWN_TIMEOUT=10

# ============ 数据库 ============
# ★ 关键约束：Prisma 的 provider 在【生成 client 时】确定，且迁移 SQL 是【按方言生成】的。
#   仓库里现在有两套 schema，按运行环境选一套（用 PRISMA_SCHEMA 环境变量指定，默认 sqlite 那套）：
#     · apps/example-api/prisma/schema.prisma      provider = sqlite     迁移在 prisma/migrations/
#     · apps/example-api/prisma/pg/schema.prisma   provider = postgresql 迁移在 prisma/pg/migrations/
#   两者模型段逐字节一致，仅 provider 与迁移目录不同。**方言不可互换**，SQLite 的
#   migrations/*.sql（DATETIME 等）直接灌进 PostgreSQL 必然失败。
#   本机开发保持默认；真机接 PostgreSQL 时必须：
#     export PRISMA_SCHEMA=prisma/pg/schema.prisma
#   并确保 prisma generate 与运行环境用同一套（否则运行期报 datasource provider 不匹配）。
#   新增模型时两份 schema 都要改，漂移校验见 docs/62-1panel-real-deploy.md §4。
#
# --- A) 本机开发 / 单实例起步档：SQLite（零外部依赖）---
DB_DRIVER=sqlite
DB_URL=file:/opt/fw/shared/data/app.db
# --- B) 生产档（本次真机部署采用）：1Panel 本机容器 PostgreSQL ---
#   ★ host 必须写 127.0.0.1：应用由 systemd 跑在宿主机（不是容器），因此用回环地址；
#     容器名只在容器内互访时可用，写这里必然 ECONNREFUSED。
#   ★ 端口取 1Panel → 数据库 → 该库「连接信息」里的**宿主映射端口**（默认 5432，常被改成 15432 等）。
#   ★ 配了 PRISMA_SCHEMA=prisma/pg/schema.prisma 才可启用本档。
# DB_DRIVER=postgres
# DB_URL=postgresql://fw:<密码>@127.0.0.1:5432/fw?schema=public&connection_limit=10
# --- B') 生产档：云 RDS PostgreSQL / MySQL（连接串同上，地址换成 RDS 内网地址）---
# DB_URL=postgresql://fw:<密码>@<rds内网地址>:5432/fw?schema=public&connection_limit=20
# DB_URL=mysql://fw:<密码>@<rds内网地址>:3306/fw
# 慢查询告警阈值（毫秒）
DB_SLOW_MS=500

# ============ 缓存（M4）============
# 单机起步可用 memory；多实例/生产建议 redis（云 Redis 或本机 redis-server）
CACHE_DRIVER=memory
CACHE_URL=
CACHE_PREFIX=fw:prod
CACHE_FAIL_OPEN=true
# 改用 redis 时打开下面两行（CACHE_URL 形如 redis://:<密码>@127.0.0.1:6379/0）
# CACHE_DRIVER=redis
# CACHE_URL=redis://:<密码>@127.0.0.1:6379/0

# ============ 队列与定时任务（M7）============
# memory 仅单进程可用；多实例或需要定时任务单点执行时必须 bullmq + Redis
MQ_DRIVER=memory
MQ_URL=
MQ_PREFIX=fw:prod
MQ_CRON_ENABLED=true
MQ_SHUTDOWN_TIMEOUT=30
# 改用 bullmq 时打开（留空回退 CACHE_URL）
# MQ_DRIVER=bullmq
# MQ_URL=redis://:<密码>@127.0.0.1:6379/1

# ============ 鉴权（M3）============
AUTH_STRATEGY=jwt
# 生成：openssl rand -base64 48（长度不足 32 字节会启动失败）
JWT_SECRET=CHANGE_ME_openssl_rand_base64_48
# 密钥轮换过渡期可用：填上一个旧密钥，校验时双密钥并行
JWT_SECRET_PREV=
AUTH_ACCESS_TTL=2h
AUTH_REFRESH_TTL=7d
AUTH_MAX_FAILED=5
AUTH_LOCK_MINUTES=15
AUTH_PASSWORD_POLICY=medium
# 生产关闭自助注册（由管理后台建号）
AUTH_ALLOW_REGISTER=false
AUTH_API_KEYS=

# ============ 多租户（M8 / @fw/tenant）============
# 单租户站点保持 false（解析直接短路，零开销）；多租户站点置 true
TENANT_ENABLED=false
TENANT_ORDER=subdomain,header,jwt
TENANT_HEADER_NAME=x-tenant-id
TENANT_BASE_DOMAIN=
TENANT_JWT_CLAIM=tenantId
TENANT_CACHE_TTL=60
# dedicated 租户独立库连接串的加密密钥：生成 openssl rand -hex 32；缺省会用内置开发密钥并告警，生产必须显式配置
TENANT_DB_KEY=

# ============ 传输层（M8 / @fw/transport）============
# 单体保持 in-process；拆服务后改 redis（业务代码零改动）
TRANSPORT_DRIVER=in-process
TRANSPORT_URL=
TRANSPORT_PREFIX=fw:prod
TRANSPORT_TIMEOUT_MS=5000
# fw-api 保持 both；fw-worker@.service 已在单元内强制 handler
TRANSPORT_ROLE=both
TRANSPORT_INSTANCE_ID=
TRANSPORT_SHUTDOWN_TIMEOUT=10

# ============ 链路追踪（M8 / @fw/telemetry）============
# ★ 启用前必须确保 @opentelemetry/sdk-node 与 @opentelemetry/exporter-trace-otlp-http 已安装：
#   二者在 @fw/telemetry 是 optional peerDependency，在 apps/example-api 属 devDependencies——
#   裸机全量 pnpm install（含 devDeps）自带；若服务器上只装生产依赖（--prod），
#   必须在应用 package.json 的 dependencies 里显式声明这两个包，否则 OTEL_ENABLED=true 会启动即失败。
OTEL_ENABLED=false
OTEL_SERVICE_NAME=fw-api
# OTEL_ENABLED=true 时必填（缺失不静默丢 span，而是启动即失败）
OTEL_EXPORTER_URL=
OTEL_SAMPLE_RATIO=0.1
OTEL_SAMPLE_ERRORS=true

# ============ 可选 ============
# 写入 PID 文件供外部信号脚本使用（默认留空关闭，避免污染生产）
FW_PID_FILE=
