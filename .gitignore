# 依赖与构建产物
node_modules/
dist/
build/
coverage/
.turbo/
*.tsbuildinfo

# 环境变量（示例文件除外）
.env
.env.*
!.env.example

# 日志与本地数据
*.log
*.sqlite
*.db
# 手工备份的 sqlite 库（改名后不再匹配 *.db，但同属本地数据）
*.db.bak*

# IDE 与系统文件
.idea/
.vscode/
.DS_Store
Thumbs.db

# Prisma 生成产物（prisma generate 的输出，含平台相关二进制，CI 会重新生成）
packages/db/prisma/test-client/
# 三库一致性矩阵的 prisma generate 输出（T-M2-07，由 packages/db/scripts/matrix-db-setup.mjs 配套生成）
packages/db/prisma/matrix-client-*/

# 三库矩阵/联通性探测的临时脚本与产物（本地一次性，不入版本库）
.tmp-dbtest/

# 本地工具数据（AI 会话状态与项目记忆，不入版本库）
.workbuddy/

# vitest / vite 加载 .ts 配置时生成的临时包装文件
*.timestamp-*.mjs

*.db-journal

# @fw/storage local 驱动默认根目录（运行期产物，不入库）
uploads/

# @fw/storage local 驱动默认根目录（运行期产物，不入库）
apps/example-api/uploads/
template-admin-smoke/uploads/

# M14 浏览器验收产物：脚本可复跑生成，截图不入库（report.json 作为证据快照入库）
apps/admin-web/e2e-artifacts/*.png

# 部署状态与本地产物（fw deploy 生成，属环境相关，不入版本库）
deploy.manifest.json
deploy-report.json
backups/
.tmp-*

# fw verify 产物
verify-report.json
verify-artifacts/
apps/auto-verify/
.verify-process.log
apps/*/.verify-process.log
apps/*/*/.verify-process.log

# CI 轮询的临时状态（本机排查用，不入版本库）
.ci-runs.json
.ci-rerun.json
.ci-status.json
runs.json
