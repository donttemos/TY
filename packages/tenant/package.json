{
  "name": "@fw/tenant",
  "version": "0.1.0",
  "description": "多租户：三级回退租户解析（子域名/请求头/JWT claim，顺序与开关可配）、租户信息服务、fail-closed 上下文注入（PRD-008 FR-01）",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fw/config": "workspace:*",
    "@fw/core": "workspace:*",
    "@fw/logger": "workspace:*",
    "@nestjs/common": "^11.2.7",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11"
  }
}
