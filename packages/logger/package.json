{
  "name": "@fw/logger",
  "version": "0.5.0",
  "description": "日志模块：结构化 JSON 日志、traceId 注入、敏感字段脱敏",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11"
  }
}
