{
  "name": "@fw/db",
  "version": "0.1.0",
  "description": "数据库抽象层：统一 Repository 接口、多驱动适配、迁移与观测（PRD-002）",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "prisma"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test:coverage": "vitest run --coverage",
    "matrix:setup": "node scripts/matrix-db-setup.mjs",
    "matrix:generate": "prisma generate --schema prisma/test-schema.mysql.prisma && prisma generate --schema prisma/test-schema.postgresql.prisma"
  },
  "dependencies": {
    "@fw/config": "workspace:*",
    "@fw/core": "workspace:*",
    "@fw/logger": "workspace:*",
    "@nestjs/common": "^11.2.7",
    "@prisma/client": "^6.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "prisma": "^6.3.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11"
  }
}
