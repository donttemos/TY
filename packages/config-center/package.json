  },
  "dependencies": {
    "@fw/config": "workspace:*",
    "@fw/core": "workspace:*",
    "@fw/logger": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11"
  }
