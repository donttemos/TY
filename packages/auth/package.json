    "@nestjs/core": "^10.4.15",
    "@node-rs/argon2": "^2.0.2",
    "bcryptjs": "^2.4.3",
    "jose": "^5.9.6",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.15",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^2.1.9",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
