/*
 * @file 数据模型（admin 模板）
 * @description 遵循 @fw/db 通用约定：BaseEntity 六字段（id/deletedAt/createdAt/updatedAt/createdBy/updatedBy）
 *   + UUID 主键（禁自增）。含登录 + RBAC 全套鉴权表（与 @fw/auth 对齐）、字典、示例 CRUD（DemoItem）
 *   与附件元数据（UploadFile）。切换数据库只改 datasource 两行（provider/url），业务代码零改动。
 * @author donttemo
 * @created 2026-10-15
 * @module __APP_NAME__
 */
generator client {
  provider = "prisma-client-js"
}

datasource db {
  // 切换点：sqlite / postgresql / mysql（切换后需重建 migrations，见 README「数据库切换」）
  provider = "sqlite"
  url      = env("DB_URL")
}

// ---------- 鉴权与权限（与 @fw/auth 对齐，字段口径同 docs/30-data-dictionary.md §3.1~3.9） ----------

/// 用户
model User {
  id           String    @id @default(uuid())
  tenantId     BigInt    @default(0) @map("tenant_id")
  username     String    @unique
  phone        String?   @unique
  email        String?   @unique
  passwordHash String    @map("password_hash")
  nickname     String?
  avatar       String?
  status       Int       @default(1)
  lastLoginAt  DateTime? @map("last_login_at")
  lastLoginIp  String?   @map("last_login_ip")
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  createdBy    String    @default("system") @map("created_by")
  updatedBy    String    @default("system") @map("updated_by")

  @@index([tenantId], map: "idx_users_tenant")
  @@index([status], map: "idx_users_status")
  @@map("users")
}

/// 角色
model Role {
  id        String    @id @default(uuid())
  tenantId  BigInt    @default(0) @map("tenant_id")
  code      String
  name      String
  remark    String?
  isSystem  Int       @default(0) @map("is_system")
  dataScope String    @default("self") @map("data_scope")
  sort      Int       @default(0)
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String    @default("system") @map("created_by")
  updatedBy String    @default("system") @map("updated_by")

  @@unique([tenantId, code], map: "uk_roles_tenant_code")
  @@index([tenantId], map: "idx_roles_tenant")
  @@map("roles")
}

/// 权限点（编码 `资源:操作`，类型 menu/button/api）
model Permission {
  id        String    @id @default(uuid())
  code      String    @unique
  name      String
  type      String    @default("api")
  module    String?
  sort      Int       @default(0)
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String    @default("system") @map("created_by")
  updatedBy String    @default("system") @map("updated_by")

  @@index([type], map: "idx_permissions_type")
  @@index([module], map: "idx_permissions_module")
  @@map("permissions")
}

/// 用户-角色关联
model UserRole {
  userId String @map("user_id")
  roleId String @map("role_id")

  @@id([userId, roleId])
  @@index([roleId], map: "idx_ur_role")
  @@index([userId], map: "idx_ur_user")
  @@map("user_role")
}

/// 角色-权限关联
model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  @@id([roleId, permissionId])
  @@map("role_permission")
}

/// 菜单（后台动态路由数据源）
model Menu {
  id             String    @id @default(uuid())
  parentId       String    @default("0") @map("parent_id")
  name           String
  path           String?
  component      String?
  icon           String?
  permissionCode String?   @map("permission_code")
  visible        Int       @default(1)
  sort           Int       @default(0)
  deletedAt      DateTime? @map("deleted_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  createdBy      String    @default("system") @map("created_by")
  updatedBy      String    @default("system") @map("updated_by")

  @@index([parentId], map: "idx_menus_parent")
  @@index([permissionCode], map: "idx_menus_perm")
  @@map("menus")
}

/// 组织部门（树形，parentId='0' 为顶级；org / org_below 数据范围依赖）
model Department {
  id        String    @id @default(uuid())
  tenantId  BigInt    @default(0) @map("tenant_id")
  parentId  String    @default("0") @map("parent_id")
  code      String?
  name      String
  leaderId  String?   @map("leader_id")
  sort      Int       @default(0)
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String    @default("system") @map("created_by")
  updatedBy String    @default("system") @map("updated_by")

  @@unique([tenantId, code], map: "uk_dept_tenant_code")
  @@index([tenantId], map: "idx_dept_tenant")
  @@index([parentId], map: "idx_dept_parent")
  @@map("departments")
}

/// 用户-部门关联（支持多部门，isPrimary 标主部门）
model UserDepartment {
  userId       String @map("user_id")
  departmentId String @map("department_id")
  isPrimary    Int    @default(0) @map("is_primary")

  @@id([userId, departmentId])
  @@index([departmentId], map: "idx_ud_dept")
  @@map("user_department")
}

/// 刷新令牌（只存哈希 + 轮换族）
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  familyId  String    @map("family_id")
  expireAt  DateTime  @map("expire_at")
  revokedAt            DateTime? @map("revoked_at")
  loginIp              String?   @map("login_ip")
  userAgent            String?   @map("user_agent")
  replacedById         String?   @map("replaced_by_id")
  replacementCipher    String?   @map("replacement_cipher")
  replacementKeyId     String?   @map("replacement_key_id")
  replacementExpiresAt DateTime? @map("replacement_expires_at")
  rotatedFingerprint   String?   @map("rotated_fingerprint")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String    @default("system") @map("created_by")
  updatedBy String    @default("system") @map("updated_by")

  @@index([userId], map: "idx_rt_user")
  @@index([familyId], map: "idx_rt_family")
  @@index([expireAt], map: "idx_rt_expire")
  @@index([replacedById], map: "idx_rt_replaced_by")
  @@map("refresh_tokens")
}

/// 审计日志（仅创建，不更新不删除）
model AuditLog {
  id          String   @id @default(uuid())
  tenantId    BigInt   @default(0) @map("tenant_id")
  userId      String?  @map("user_id")
  module      String
  action      String
  category    String?  @map("category")
  event       String?  @map("event")
  result      String?  @map("result")
  familyId    String?  @map("family_id")
  jti         String?  @map("jti")
  requestId   String?  @map("request_id")
  targetType  String?  @map("target_type")
  targetId    String?  @map("target_id")
  beforeValue Json?    @map("before_value")
  afterValue  Json?    @map("after_value")
  ip          String?
  userAgent   String?  @map("user_agent")
  traceId     String?  @map("trace_id")
  createdAt   DateTime @default(now()) @map("created_at")
  /// PRD-015（ADR-0032）：业务快照——会随业务数据漂移的事实，事件发生时固化
  summary     String?
  targetLabel String?  @map("target_label")
  actorLabel  String?  @map("actor_label")
  reason      String?
  auditSource String?  @map("audit_source")

  @@index([tenantId], map: "idx_audit_tenant")
  @@index([userId], map: "idx_audit_user")
  @@index([action], map: "idx_audit_action")
  @@index([targetType, targetId], map: "idx_audit_target")
  @@index([traceId], map: "idx_audit_trace")
  @@index([event], map: "idx_audit_event")
  @@index([familyId], map: "idx_audit_family")
  @@index([requestId], map: "idx_audit_request")
  @@index([category, createdAt], map: "idx_audit_category_created")
  @@index([createdAt], map: "idx_audit_created")
  @@index([result, createdAt], map: "idx_audit_result_created")
  @@map("audit_logs")
}

// ---------- 字典（PRD-005 FR-07：页面不硬编码枚举） ----------

/// 字典分类
model DictCategory {
  id        String    @id @default(uuid())
  code      String    @unique
  name      String
  remark    String?
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String    @default("system") @map("created_by")
  updatedBy String    @default("system") @map("updated_by")

  @@index([deletedAt], map: "idx_dict_cat_deleted")
  @@map("dict_categories")
}

/// 字典项（value 为程序值，label 为展示值，color 供标签取色）
model DictItem {
  id         String    @id @default(uuid())
  categoryId String    @map("category_id")
  label      String
  value      String
  color      String?
  sort       Int       @default(0)
  deletedAt  DateTime? @map("deleted_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  createdBy  String    @default("system") @map("created_by")
  updatedBy  String    @default("system") @map("updated_by")

  @@unique([categoryId, value], map: "uk_dict_item_category_value")
  @@index([categoryId], map: "idx_dict_item_category")
  @@index([deletedAt], map: "idx_dict_item_deleted")
  @@map("dict_items")
}

// ---------- 业务示例 ----------

/// 示例业务模型：演示条目（fw gen crud 产物形态）
model DemoItem {
  id        String    @id @default(uuid())
  title     String
  done      Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String    @default("system") @map("created_by")
  updatedBy String    @default("system") @map("updated_by")

  @@map("demo_items")
}

/// 附件元数据（admin 模板上传端点；文件本体在 UPLOAD_DIR 本地磁盘，E-09 后可平移对象存储）
model UploadFile {
  id           String    @id @default(uuid())
  ownerId      String?   @map("owner_id")
  originalName String    @map("original_name")
  storedName   String    @map("stored_name")
  mimeType     String    @map("mime_type")
  size         Int
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  createdBy    String    @default("system") @map("created_by")
  updatedBy    String    @default("system") @map("updated_by")

  @@index([ownerId], map: "idx_upload_owner")
  @@map("upload_files")
}
