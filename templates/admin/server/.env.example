# @file 环境变量示例（admin 模板服务端）
# @description 复制为 .env 后按需修改；必填项缺失时启动即失败并列出缺失项。
#   JWT_SECRET 为必填（鉴权不允许无密钥静默降级）；下方占位值仅供本地开发，生产必须更换为 ≥32 位强随机密钥。
# @author donttemo
# @created 2026-10-15

# 运行环境（必填）：default / dev / test / prod
APP_ENV=dev
# HTTP 监听端口
APP_PORT=3000
# 日志级别：trace / debug / info / warn / error / fatal
LOG_LEVEL=info
# 优雅停机等待在途请求的超时（秒）
SHUTDOWN_TIMEOUT=10

# ---- 数据库（改 DB_DRIVER + DB_URL 即可切换，业务代码零改动） ----
# sqlite  : file:./dev.db
# postgres: postgresql://user:pass@localhost:5432/app
# mysql   : mysql://user:pass@localhost:3306/app
# 注意：切换 provider 后需重建 migrations（见 README「数据库切换」）
DB_DRIVER=sqlite
DB_URL=file:./dev.db
# 慢查询告警阈值（毫秒）
DB_SLOW_MS=500

# ---- 缓存（memory 默认；redis 驱动下权限缓存 / 登录限流 / 令牌黑名单多实例一致） ----
CACHE_DRIVER=memory
CACHE_URL=

# ---- 鉴权（admin 模板核心） ----
# 认证策略：jwt（模板默认端到端打通的一种）
AUTH_STRATEGY=jwt
# JWT 签名密钥（必填，≥32 位；生产严禁使用下方占位值）
JWT_SECRET=dev-only-placeholder-not-for-production-32bytes
# 轮换过渡期旧密钥（可选；不得与 JWT_SECRET 相同）
JWT_SECRET_PREV=
# 访问令牌 TTL
AUTH_ACCESS_TTL=2h
# 刷新令牌 TTL
AUTH_REFRESH_TTL=7d
# 连续登录失败锁定阈值与时长
AUTH_MAX_FAILED=5
AUTH_LOCK_MINUTES=15
# 是否开放自助注册（默认关闭，管理后台账号由管理员创建）
AUTH_ALLOW_REGISTER=false

# ---- 框架级 API 限流（E-03：令牌桶状态存 CACHE_STORE，默认开启可白名单豁免） ----
# 令牌桶容量（每 IP 突发上限）：超出即 429/9003
RATE_LIMIT_CAPACITY=600
# 每秒补充令牌数
RATE_LIMIT_REFILL_PER_SECOND=10
# 豁免前缀（逗号分隔）
RATE_LIMIT_WHITELIST=/health,/ready,/metrics
# 缓存驱动故障时放行（fail-open）还是拒绝（fail-closed）
RATE_LIMIT_FAIL_OPEN=true
# 灰度观测：true 时仅计数告警不拦截
RATE_LIMIT_DRY_RUN=false

# ---- 文件存储端口（PRD-010 E-09，@fw/storage） ----
# 存储驱动：local = 本地磁盘（默认）；s3 = S3 兼容对象存储（需安装 @aws-sdk/client-s3）
STORAGE_DRIVER=local
# local 驱动存储根目录（对象 key 为其下相对路径 <yyyyMM>/<uuid><ext>；替代原 UPLOAD_DIR）
STORAGE_LOCAL_ROOT=./uploads
# 单文件大小上限（MB）：超出 400 拒绝（不静默截断）
STORAGE_MAX_MB=20
# 上传扩展名白名单（逗号分隔，大小写不敏感；默认收紧，按需放宽）
STORAGE_ALLOWED_EXTS=.png,.jpg,.jpeg,.gif,.webp,.pdf,.txt,.csv,.xlsx,.docx,.zip
# S3 驱动其余键（端点/区域/桶名/密钥/path-style）见 @fw/storage 文档与 apps/example-api/.env.example
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=us-east-1
STORAGE_S3_BUCKET=
