{
  "name": "__APP_NAME__-server",
  "version": "0.1.0",
  "private": true,
  "description": "由 @fw/cli 生成的管理后台服务端（登录 + RBAC + 示例 CRUD + 附件上传）",
  "type": "module",
  "scripts": {
    "dev": "node --watch --enable-source-maps dist/main.js",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.json",
    "check": "fw check",
    "db:migrate": "fw db:migrate",
    "db:rollback": "fw db:rollback",
    "db:seed": "fw db:seed",
    "db:reset": "fw db:rollback && fw db:migrate && fw db:seed",
    "prisma:generate": "prisma generate"
  },
  "dependencies": {
    "@fw/auth": "workspace:*",
    "@fw/cache": "workspace:*",
    "@fw/config": "workspace:*",
    "@fw/core": "workspace:*",
    "@fw/db": "workspace:*",
    "@fw/logger": "workspace:*",
    "@fw/storage": "workspace:*",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "@prisma/client": "^6.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@fw/cli": "workspace:*",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.0.0",
    "prisma": "^6.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
