# @file 环境变量示例（模板）
# @description 复制为 .env 后按需修改；必填项缺失时启动即失败并列出缺失项
# @author donttemo
# @created 2026-10-09

# 运行环境（必填）：default / dev / test / prod
APP_ENV=dev
# HTTP 监听端口
APP_PORT=3000
# 日志级别：trace / debug / info / warn / error / fatal
LOG_LEVEL=info
# 优雅停机等待在途请求的超时（秒）
SHUTDOWN_TIMEOUT=10

# ---- 数据库（M2：改 DB_DRIVER + DB_URL 即可切换，业务代码零改动） ----
# sqlite  : file:./dev.db
# postgres: postgresql://user:pass@localhost:5432/app
# mysql   : mysql://user:pass@localhost:3306/app
DB_DRIVER=sqlite
DB_URL=file:./dev.db
# ---- 缓存（M4 生效，M2 仅校验与透传） ----
CACHE_DRIVER=memory
CACHE_URL=
# ---- 鉴权与消息（M3/M7 生效，M2 仅校验与透传） ----
AUTH_STRATEGY=jwt
MQ_DRIVER=memory
# 慢查询告警阈值（毫秒）
DB_SLOW_MS=500
