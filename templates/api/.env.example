# @file 环境变量示例（模板）
# @description 复制为 .env 后按需修改；必填项缺失时启动即失败并列出缺失项
# @author donttemo
# @created 2026-10-09
# @modified 2026-10-14 donttemo M8 T-M8-05 追加 TRANSPORT_* 段（驱动/连接/前缀/超时/角色）
# @modified 2026-10-14 donttemo M8 T-M8-06 追加 OTEL_* 段（链路追踪开关/服务名/OTLP 端点/采样率/错误全采）
# @modified 2026-10-14 donttemo M8 T-M8-01/02 补 TENANT_* 段（多租户开关/回退顺序/来源/缓存/dedicated 密钥）
# @modified 2026-10-15 donttemo E-08 补 RATE_LIMIT_* 段（E-03 框架级限流的模板 env 同源缺口）

# 运行环境（必填）：default / dev / test / prod
APP_ENV=dev
# HTTP 监听端口
APP_PORT=3000
# 日志级别：trace / debug / info / warn / error / fatal
LOG_LEVEL=info
# 优雅停机等待在途请求的超时（秒）
SHUTDOWN_TIMEOUT=10

# ---- 数据库（M2：改 DB_DRIVER + DB_URL 即可切换，业务代码零改动） ----
# sqlite  : file:./dev.db
# postgres: postgresql://user:pass@localhost:5432/app
# mysql   : mysql://user:pass@localhost:3306/app
DB_DRIVER=sqlite
DB_URL=file:./dev.db
# ---- 缓存（M4 生效，M2 仅校验与透传） ----
CACHE_DRIVER=memory
CACHE_URL=
# ---- 鉴权与消息（M3/M7 生效，M2 仅校验与透传） ----
AUTH_STRATEGY=jwt
# 慢查询告警阈值（毫秒）
DB_SLOW_MS=500

# ---- 队列与定时任务（M7：接入 @fw/queue 后生效；未接入时仅校验与透传） ----
# 驱动：memory（进程内零依赖）/ bullmq（Redis，需 pnpm add bullmq ioredis）
MQ_DRIVER=memory
# 队列 Redis 连接串（bullmq 驱动必填；留空时回退 CACHE_URL）
MQ_URL=
# 队列名前缀（留空自动取 fw:<APP_ENV>，防多环境串队列）
MQ_PREFIX=
# 每队列并发数
MQ_CONCURRENCY=10
# 单个任务最大执行次数（含首次）：4 = 首次 + 3 次重试
MQ_MAX_ATTEMPTS=4
# 重试退避序列（毫秒，逗号分隔）：第 n 次重试前等待第 n 项，超出取最后一项
MQ_BACKOFF=1000,5000,30000
# 单任务执行超时（秒）
MQ_JOB_TIMEOUT=60
# 是否启用定时任务调度（false 时不注册 cron）
MQ_CRON_ENABLED=true
# 每队列每秒处理上限（0 = 不限速）
MQ_RATE_LIMIT=0
# 死信保留上限（超出丢弃最旧）
MQ_DEAD_LETTER_MAX=1000
# 优雅停机等待在途任务的超时（秒）
MQ_SHUTDOWN_TIMEOUT=30

# bullmq 失速检测间隔（毫秒；0 = 用 bullmq 默认 30s）
MQ_STALLED_MS=30000

# ---- 多租户（M8 T-M8-01/02：接入 @fw/tenant 后生效；未接入时仅校验与透传） ----
# 多租户总开关（false 时全部接口按单租户运行，解析零开销短路）
TENANT_ENABLED=false
# 租户解析回退顺序（subdomain/header/jwt 的子序列，逗号分隔；未列出的来源即关闭）
TENANT_ORDER=subdomain,header,jwt
# 请求头来源的头部名（小写）
TENANT_HEADER_NAME=x-tenant-id
# 子域名解析基准域名（留空时 subdomain 来源关闭）
TENANT_BASE_DOMAIN=
# JWT claim 来源的字段名（取 access token 载荷）
TENANT_JWT_CLAIM=tenantId
# tenants 表查询结果的内存缓存 TTL（秒）
TENANT_CACHE_TTL=60
# dedicated 独立库连接串的加密密钥（64 位十六进制或 base64；生产必须显式配置）
TENANT_DB_KEY=

# ---- 传输层（M8 T-M8-05：接入 @fw/transport 后生效；未接入时仅校验与透传） ----
# 驱动：in-process（进程内直调，零依赖）/ redis（跨进程 RPC，需 pnpm add ioredis）
TRANSPORT_DRIVER=in-process
# 传输 Redis 连接串（redis 驱动必填；留空时回退 CACHE_URL）
TRANSPORT_URL=
# 传输 key 前缀（留空自动取 fw:<APP_ENV>，防多环境串数据）
TRANSPORT_PREFIX=
# 单次传输调用超时（毫秒）
TRANSPORT_TIMEOUT_MS=5000
# 本进程传输角色：caller 只调用 / handler 只处理 / both 两者兼顾（默认）
TRANSPORT_ROLE=both
# 传输实例标识（诊断用）；缺省 host-<pid>
TRANSPORT_INSTANCE_ID=
# 传输优雅停机等待在途请求的超时（秒）
TRANSPORT_SHUTDOWN_TIMEOUT=10

# ---- 链路追踪（M8 T-M8-06：接入 @fw/telemetry 后生效；未接入时仅校验与透传） ----
# 总开关（false = 全短路零开销）
OTEL_ENABLED=false
# 服务名（留空自动取 fw:<APP_ENV>）
OTEL_SERVICE_NAME=
# OTLP/HTTP 采集端点（OTEL_ENABLED=true 时必填，缺失启动即失败）
OTEL_EXPORTER_URL=
# 采样比例（0-1，默认 10%）
OTEL_SAMPLE_RATIO=0.1
# 错误 span 全采（true 时错误链路不丢）
OTEL_SAMPLE_ERRORS=true

# ---------- M10 框架级 API 限流（E-03：令牌桶状态存 CACHE_STORE，默认开启可白名单豁免） ----------
# 令牌桶容量（每 IP 突发上限）：超出即 429/9003
RATE_LIMIT_CAPACITY=600
# 每秒补充令牌数
RATE_LIMIT_REFILL_PER_SECOND=10
# 豁免前缀（逗号分隔）
RATE_LIMIT_WHITELIST=/api/v1/health,/api/v1/ready,/api/v1/metrics
# 缓存驱动故障时放行（fail-open）还是拒绝（fail-closed）
RATE_LIMIT_FAIL_OPEN=true
# 灰度观测：true 时仅计数告警不拦截
RATE_LIMIT_DRY_RUN=false

# ---------- M9 配置中心（@fw/config-center，PRD-009） ----------
# 总开关（false = 零开销：不读文件不起轮询，PUT /configs 一律 1004）
CONFIG_CENTER_ENABLED=false
# 事实源适配器（首版仅 file：本地文件 + mtime 轮询；nacos 为预留注册位，非法取值启动即失败）
CONFIG_CENTER_DRIVER=file
# 运行时配置文件路径（点路径 → 覆盖值的 JSON 对象；file 适配为单实例语义）
CONFIG_CENTER_FILE=./config/runtime.json
# mtime 轮询间隔（秒）；热更生效延迟上界 = 轮询间隔 + 1s，文件损坏时保持最后一份有效快照（fail-keep）
CONFIG_CENTER_POLL_SECONDS=5
