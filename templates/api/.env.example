# @file 环境变量示例（模板）
# @description 复制为 .env 后按需修改；必填项缺失时启动即失败并列出缺失项
# @author donttemo
# @created 2026-10-09

# 运行环境（必填）：default / dev / test / prod
APP_ENV=dev
# HTTP 监听端口
APP_PORT=3000
# 日志级别：trace / debug / info / warn / error / fatal
LOG_LEVEL=info
# 优雅停机等待在途请求的超时（秒）
SHUTDOWN_TIMEOUT=10

# ---- 数据库（M2：改 DB_DRIVER + DB_URL 即可切换，业务代码零改动） ----
# sqlite  : file:./dev.db
# postgres: postgresql://user:pass@localhost:5432/app
# mysql   : mysql://user:pass@localhost:3306/app
DB_DRIVER=sqlite
DB_URL=file:./dev.db
# ---- 缓存（M4 生效，M2 仅校验与透传） ----
CACHE_DRIVER=memory
CACHE_URL=
# ---- 鉴权与消息（M3/M7 生效，M2 仅校验与透传） ----
AUTH_STRATEGY=jwt
# 慢查询告警阈值（毫秒）
DB_SLOW_MS=500

# ---- 队列与定时任务（M7：接入 @fw/queue 后生效；未接入时仅校验与透传） ----
# 驱动：memory（进程内零依赖）/ bullmq（Redis，需 pnpm add bullmq ioredis）
MQ_DRIVER=memory
# 队列 Redis 连接串（bullmq 驱动必填；留空时回退 CACHE_URL）
MQ_URL=
# 队列名前缀（留空自动取 fw:<APP_ENV>，防多环境串队列）
MQ_PREFIX=
# 每队列并发数
MQ_CONCURRENCY=10
# 单个任务最大执行次数（含首次）：4 = 首次 + 3 次重试
MQ_MAX_ATTEMPTS=4
# 重试退避序列（毫秒，逗号分隔）：第 n 次重试前等待第 n 项，超出取最后一项
MQ_BACKOFF=1000,5000,30000
# 单任务执行超时（秒）
MQ_JOB_TIMEOUT=60
# 是否启用定时任务调度（false 时不注册 cron）
MQ_CRON_ENABLED=true
# 每队列每秒处理上限（0 = 不限速）
MQ_RATE_LIMIT=0
# 死信保留上限（超出丢弃最旧）
MQ_DEAD_LETTER_MAX=1000
# 优雅停机等待在途任务的超时（秒）
MQ_SHUTDOWN_TIMEOUT=30
