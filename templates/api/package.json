{
  "name": "__APP_NAME__",
  "version": "0.1.0",
  "private": true,
  "description": "由 @fw/cli 生成的 API 服务项目",
  "type": "module",
  "scripts": {
    "dev": "node --watch --enable-source-maps dist/main.js",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.json",
    "check": "fw check",
    "db:migrate": "fw db:migrate",
    "db:rollback": "fw db:rollback",
    "db:seed": "fw db:seed",
    "db:reset": "fw db:rollback && fw db:migrate && fw db:seed",
    "prisma:generate": "prisma generate"
  },
  "dependencies": {
    "@fw/config": "workspace:*",
    "@fw/core": "workspace:*",
    "@fw/db": "workspace:*",
    "@fw/logger": "workspace:*",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@prisma/client": "^6.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@fw/cli": "workspace:*",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "prisma": "^6.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
