/** 空表单模型（字段与后端 Create 输入对齐） */
function emptyForm(): Record<string, unknown> {
  return {
{{#each createFields}}    {{this.name}}: undefined,
{{/each}}
  };
}

const form = reactive<Record<string, unknown>>(emptyForm());

/** 表单字段配置（与列表页同源） */
const formFields: FormField[] = [
{{formCode}}
];

/** 必填校验规则（由字段配置推导） */
const rules = computed<FormRules>(() => {
  const result: FormRules = {};
  for (const field of formFields) {
    if (field.rules?.length) result[field.prop] = field.rules;
  }
  return result;
});

// 打开弹窗时加载详情（编辑）或重置为空表单（新建）
watch(
