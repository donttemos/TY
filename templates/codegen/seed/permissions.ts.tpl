import { PrismaClient } from '@prisma/client';

const prisma = new PrismaClient();

/** 权限点定义（编码规范：资源:操作，类型 api） */
const PERMISSIONS = [
  { code: '{{model.permissionPrefix}}:create', name: '{{model.name}}-新建', type: 'api', module: '{{model.kebab}}' },
  { code: '{{model.permissionPrefix}}:read', name: '{{model.name}}-查询', type: 'api', module: '{{model.kebab}}' },
  { code: '{{model.permissionPrefix}}:update', name: '{{model.name}}-更新', type: 'api', module: '{{model.kebab}}' },
  { code: '{{model.permissionPrefix}}:delete', name: '{{model.name}}-删除', type: 'api', module: '{{model.kebab}}' },
];

/** 菜单定义（component 相对 web/src，供动态路由加载） */
const MENU = {
  name: '{{model.name}}管理',
  path: '{{model.routePath}}',
  component: 'views/{{model.kebab}}/index',
  icon: 'List',
  permissionCode: '{{model.permissionPrefix}}:read',
  visible: 1,
  sort: 0,
};

/** 超级管理员角色码：新模块的权限必须授给它，否则登录后菜单里根本没有这一项 */
const ADMIN_ROLE_CODE = 'admin';

/**
 * 把本次生成的权限点授给超级管理员（幂等）
 * @returns 实际授予的条数（角色不存在时返回 0，不视为失败）
 * @description 只建权限点不授权，`/auth/menus` 会按用户权限码过滤掉这个菜单——用户在后台
 *   看不到刚生成的模块，只能以为「生成失败」。此前的全量 seed 里 admin 拿的是
 *   GENERATED_PERMISSION_CODES 清单，而 `fw gen crud` 的定向种子不经过那条清单，于是漏授权。
 */
async function grantToAdminRole(): Promise<number> {
  // role.code 不是唯一键（多租户下可重名），只能按 code + 未删除查首条
  const role = await prisma.role.findFirst({
    where: { code: ADMIN_ROLE_CODE, deletedAt: null },
    orderBy: { createdAt: 'asc' },
  });
  if (!role) return 0;
  let granted = 0;
  for (const permission of PERMISSIONS) {
    const row = await prisma.permission.findUnique({ where: { code: permission.code } });
    if (!row) continue;
    await prisma.rolePermission.upsert({
      where: { roleId_permissionId: { roleId: role.id, permissionId: row.id } },
      create: { roleId: role.id, permissionId: row.id },
      update: {},
    });
    granted += 1;
  }
  return granted;
}

/**
 * 幂等写入{{model.name}}权限点与菜单
 * 权限点按 code 唯一键 upsert；菜单按 path 查重后更新或新建（可重复执行）
 */
export async function seed{{model.name}}Permissions(): Promise<void> {
  for (const permission of PERMISSIONS) {
    await prisma.permission.upsert({
      where: { code: permission.code },
      create: permission,
      update: permission,
    });
  }
  const existing = await prisma.menu.findFirst({ where: { path: MENU.path } });
  if (existing) {
    await prisma.menu.update({ where: { id: existing.id }, data: MENU });
  } else {
    await prisma.menu.create({ data: MENU });
  }
  const granted = await grantToAdminRole();
  console.log(
    `[seed] 已写入 {{model.name}} 权限点 ${PERMISSIONS.length} 个与菜单 1 条（授给 ${ADMIN_ROLE_CODE} 角色 ${granted} 条）`,
  );
}

// 允许独立执行（pnpm exec tsx prisma/seed/{{model.kebab}}.seed.ts），被 seed.ts 引用时也可复用
const isDirectRun = process.argv[1]?.includes('{{model.kebab}}.seed');
if (isDirectRun) {
  seed{{model.name}}Permissions()
    .catch((error: unknown) => {
      console.error('[seed] 失败:', error);
      process.exit(1);
    })
    .finally(() => prisma.$disconnect());
}
