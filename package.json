{
  "name": "fw-monorepo",
  "version": "0.6.0",
  "private": true,
  "description": "通用应用框架 monorepo：框架包 + 应用 + 项目模板",
  "packageManager": "pnpm@11.6.0",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "check:headers": "node scripts/check-file-headers.mjs",
    "check:config": "fw check",
    "check:helm": "node scripts/check-helm-chart.mjs",
    "check:api-parity": "node scripts/check-api-parity.mjs",
    "check:no-raw-throw": "node scripts/check-no-raw-throw.mjs",
    "gen:error-codes": "node scripts/gen-error-codes-json.mjs",
    "check:triway-consistency": "node scripts/check-triway-consistency.mjs",
    "smoke:template-admin": "node scripts/smoke-template-admin.mjs"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.6.0"
  }
}
