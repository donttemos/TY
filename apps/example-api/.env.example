# @file 环境变量示例
# @description 复制为 .env 后按需修改；必填项缺失时启动即失败并列出缺失项
# @author donttemo
# @created 2026-10-09
# @modified 2026-10-14 donttemo M8 T-M8-05 追加 TRANSPORT_* 段（驱动/连接/前缀/超时/角色/实例标识/停机等待）
# @modified 2026-10-14 donttemo M8 T-M8-06 追加 OTEL_* 段（链路追踪开关/服务名/OTLP 端点/采样率/错误全采）
# @modified 2026-10-15 donttemo M9/PRD-009 追加 CONFIG_CENTER_* 段（总开关/适配器/事实源文件/轮询间隔）

# 运行环境（必填）：default / dev / test / prod
APP_ENV=dev
# HTTP 监听端口
APP_PORT=3000
# 日志级别：trace / debug / info / warn / error / fatal
LOG_LEVEL=info
# 优雅停机等待在途请求的超时（秒）
SHUTDOWN_TIMEOUT=10

# ---- 数据库（M2：改 DB_DRIVER + DB_URL 即可切换，业务代码零改动） ----
# sqlite  : file:./dev.db
# postgres: postgresql://user:pass@localhost:5432/app
# mysql   : mysql://user:pass@localhost:3306/app
DB_DRIVER=sqlite
DB_URL=file:./dev.db
# 慢查询告警阈值（毫秒）
DB_SLOW_MS=500

# ---- 缓存（M4：改 CACHE_DRIVER 即可 memory → redis，业务代码零改动） ----
# 驱动：memory / redis / redis-cluster
CACHE_DRIVER=memory
# Redis 连接串（驱动为 redis/redis-cluster 时必填；cluster 为逗号分隔节点列表）
CACHE_URL=
# key 全局前缀（留空自动取 fw:<APP_ENV>，防多应用/多环境串数据）
CACHE_PREFIX=
# 默认 TTL（秒）
CACHE_TTL=300
# memory 驱动容量上限（LRU 淘汰）
CACHE_MAX_ITEMS=10000
# 缓存故障降级开关：true=读直查/写忽略（fail-open），false=抛 9002
CACHE_FAIL_OPEN=true
# 空值占位 TTL（秒）：防穿透
CACHE_NULL_TTL=60
# TTL 随机抖动比例（0-1）：防雪崩
CACHE_TTL_JITTER=0.1
# 分布式锁默认 TTL（秒）
CACHE_LOCK_TTL=30
# 标签映射 TTL（秒）：防「幽灵缓存」
CACHE_TAG_TTL=86400
# 慢缓存操作告警阈值（毫秒）
CACHE_SLOW_MS=50
# 单 key 值字节上限（大 key 防护）
CACHE_MAX_VALUE_BYTES=1048576

# 鉴权策略：jwt / session / oauth2 / apikey
AUTH_STRATEGY=jwt
# 双 token 有效期（时长串：30m / 2h / 7d）
AUTH_ACCESS_TTL=2h
AUTH_REFRESH_TTL=7d
# 登录失败锁定：连续失败 N 次锁定 M 分钟（PRD-003 FR-07）
AUTH_MAX_FAILED=5
AUTH_LOCK_MINUTES=15
# refresh 轮换并发宽限窗口（秒，防并发刷新误判泄漏）
AUTH_REFRESH_GRACE_SECONDS=10
# 密码强度策略：low / medium / high
AUTH_PASSWORD_POLICY=medium
# 自助注册开关
AUTH_ALLOW_REGISTER=true
# JWT 签名密钥（必填，缺失时鉴权模块启动即失败）；JWT_SECRET_PREV 用于密钥轮换过渡期
JWT_SECRET=dev-only-change-me-please-32bytes-min
JWT_SECRET_PREV=
# API Key 列表（apikey 策略）：key:主体名[:权限码,权限码]，逗号分隔
AUTH_API_KEYS=

# 队列驱动：memory / bullmq
MQ_DRIVER=memory
# 队列 Redis 连接串（bullmq 驱动必填；留空时回退 CACHE_URL）
MQ_URL=
# 队列名前缀（留空自动取 fw:<APP_ENV>）
MQ_PREFIX=
# 每队列并发数
MQ_CONCURRENCY=10
# 单个任务最大执行次数（含首次）：4 = 首次 + 3 次重试
MQ_MAX_ATTEMPTS=4
# 重试退避序列（毫秒，逗号分隔）：第 n 次重试前等待第 n 项，超出取最后一项
MQ_BACKOFF=1000,5000,30000
# 单任务执行超时（秒）
MQ_JOB_TIMEOUT=60
# 是否启用定时任务调度（false 时不注册 cron）
MQ_CRON_ENABLED=true
# 每队列每秒处理上限（0 = 不限速）
MQ_RATE_LIMIT=0
# 死信保留上限（超出丢弃最旧）
MQ_DEAD_LETTER_MAX=1000
# 优雅停机等待在途任务的超时（秒）
MQ_SHUTDOWN_TIMEOUT=30

# bullmq 失速检测间隔（毫秒；0 = 用 bullmq 默认 30s）
MQ_STALLED_MS=30000

# ---------- M8 多租户（@fw/tenant） ----------
# 多租户总开关（false = 单租户模式，解析直接短路，行为与 M7 完全一致）
TENANT_ENABLED=false
# 租户解析回退顺序（subdomain/header/jwt 的子序列，未列出的来源即关闭）
TENANT_ORDER=subdomain,header,jwt
# 租户标识请求头名（小写）
TENANT_HEADER_NAME=x-tenant-id
# 子域名解析基准域名（未配置时 subdomain 来源关闭），如 example.com
TENANT_BASE_DOMAIN=
# JWT claim 字段名（从 access token 载荷提取租户归属）
TENANT_JWT_CLAIM=tenantId
# 租户信息缓存 TTL（秒）
TENANT_CACHE_TTL=60
# dedicated 租户独立库连接串的加密密钥（64 位十六进制或 base64；缺省用内置开发密钥并告警，生产必须显式配置）
TENANT_DB_KEY=

# ---------- M8 传输层（@fw/transport，PRD-008 FR-06 / TC-TNT-005） ----------
# 传输驱动：in-process / redis（tcp / kafka 仅预留端口，暂不入枚举）
#   in-process：进程内直调，零外部依赖（单体默认）
#   redis：跨进程 RPC（LPUSH 信封 + BLPOP 应答），微服务拆分后启用，业务代码零改动
TRANSPORT_DRIVER=in-process
# 传输 Redis 连接串（redis 驱动必填；留空时回退 CACHE_URL，两者都为空则启动失败）
TRANSPORT_URL=
# 传输 key 前缀（留空自动取 fw:<APP_ENV>，防多应用/多环境串数据）
TRANSPORT_PREFIX=
# 单次传输调用超时（毫秒）：超时抛错不等满（BLPOP 按秒粒度循环等待保证精度）
TRANSPORT_TIMEOUT_MS=5000
# 本进程传输角色：caller 只发起调用 / handler 只处理请求 / both 两者兼顾（默认）
TRANSPORT_ROLE=both
# 传输实例标识（诊断用：跨进程区分处理方）；缺省 host-<pid>
TRANSPORT_INSTANCE_ID=
# 传输优雅停机等待在途请求的超时（秒）
TRANSPORT_SHUTDOWN_TIMEOUT=10

# ---------- M8 链路追踪（@fw/telemetry，PRD-008 FR-07 / TC-TNT-006） ----------
# 链路追踪总开关（false = 全短路零开销，行为与 M7 完全一致）
OTEL_ENABLED=false
# 服务名（采集端按 service.name 聚合；留空自动取 fw:<APP_ENV>）
OTEL_SERVICE_NAME=
# OTLP/HTTP 采集端点（如 http://otel-collector:4318/v1/traces）
#   OTEL_ENABLED=true 时必填，缺失则启动即失败（不静默丢 span）；导出形态为 OTLP/HTTP JSON
OTEL_EXPORTER_URL=
# 采样比例（0-1，默认 0.1 = 10%）：按 traceId 确定性取值，同链路跨服务决策一致
OTEL_SAMPLE_RATIO=0.1
# 错误 span 全采开关（status=ERROR 或携带 exception 事件）；true 时错误链路不丢
OTEL_SAMPLE_ERRORS=true

# ---------- M9 配置中心（@fw/config-center，PRD-009） ----------
# 总开关（false = 零开销：不读文件不起轮询，PUT /configs 一律 1004）
CONFIG_CENTER_ENABLED=false
# 事实源适配器（首版仅 file：本地文件 + mtime 轮询；nacos 为预留注册位，非法取值启动即失败）
CONFIG_CENTER_DRIVER=file
# 运行时配置文件路径（点路径 → 覆盖值的 JSON 对象；file 适配为单实例语义，多实例场景实现 Nacos adapter）
CONFIG_CENTER_FILE=./config/runtime.json
# mtime 轮询间隔（秒）；热更生效延迟上界 = 轮询间隔 + 1s，文件损坏时保持最后一份有效快照（fail-keep）
CONFIG_CENTER_POLL_SECONDS=5

# ---------- M10 任务中心驱动（PRD-010 E-01） ----------
# memory = 进程内登记表（默认，N-02 原行为，多副本下任务面不可达）；
# db = jobs 表登记 + 派发实例执行（多副本下进度/下载/重跑任意实例可达）；
# bullmq = jobs 表登记 + 队列分发执行（执行实例随 MQ_DRIVER；消费 handler: job-center.execute）
# boot 键（不入热更白名单）；db/bullmq 驱动要求任务类型登记 JobRunnerRegistry 执行体工厂
JOB_CENTER_DRIVER=memory
