{
  "name": "example-api",
  "version": "0.1.0",
  "private": true,
  "description": "示例应用：每个里程碑的验证载体（M1 验证配置/日志/错误码/健康检查/优雅停机；M2 验证 Repository/迁移/切换）",
  "type": "module",
  "scripts": {
    "dev": "node --watch --enable-source-maps dist/main.js",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --root . --dir src",
    "lint": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "fw db:migrate",
    "db:rollback": "fw db:rollback",
    "db:seed": "fw db:seed",
    "prisma:generate": "prisma generate"
  },
  "dependencies": {
    "@fw/auth": "workspace:*",
    "@fw/cache": "workspace:*",
    "@fw/config": "workspace:*",
    "@fw/core": "workspace:*",
    "@fw/db": "workspace:*",
    "@fw/logger": "workspace:*",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@prisma/client": "^6.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@fw/cli": "workspace:*",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "prisma": "^6.3.0",
    "supertest": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
