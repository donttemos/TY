# @file 环境变量示例
# @description 复制为 .env.development / .env.test / .env.production 后按环境修改；VITE_ 前缀才会注入前端产物
# @author donttemo
# @created 2026-10-13

# API 基址（含版本前缀）：dev/test 走 vite mock server，prod 指向真实网关。
# 缺省时回退同源 /api/v1（见 src/utils/request.ts）——本文件不进版本库（.gitignore 的 .env.*），
# 服务器构建若缺少该键，回退可避免请求落到静态站被 nginx 拒绝 405。
VITE_API_BASE_URL=/api/v1
# 应用标题
VITE_APP_TITLE=通用应用框架
# 图形验证码钩子：false=隐藏（默认，见 PRD-005 待定问题）；true=显示验证码输入框
VITE_LOGIN_CAPTCHA=false
# 强制 mock 开关：留空=随 mode 自动（非 production 启用）
VITE_USE_MOCK=
# 令牌本地存储开关：留空/缺省=启用（refresh token 落 localStorage/sessionStorage）；
# 置 none=AUTH_STRATEGY=session（httpOnly Cookie）场景，本地不落任何令牌
VITE_AUTH_STORAGE=
# 前端错误监控 RUM 开关（M10/E-17）：留空/缺省=启用（window.error / unhandledrejection /
# Vue errorHandler 三源采集，批量经 sendBeacon 上报 POST /api/v1/telemetry/client-errors，
# fire-and-forget 不影响业务）；false = 整体关闭（零开销）。构建期注入
VITE_RUM_ENABLED=
