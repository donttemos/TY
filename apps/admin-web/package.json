    "@vue/language-core": "^3.3.13",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^21.0.1",
    "typescript": "~5.6.3",
    "unplugin-vue-components": "^32.1.0",
